<Window
    x:Class="AppWeb.Manager.Views.WebAppWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ToolbarRow" Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="Toolbar"
            Padding="8,6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Width="36"
                Height="36"
                Padding="0"
                Click="BackButton_Click"
                IsEnabled="False"
                ToolTipService.ToolTip="Voltar">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <Button
                x:Name="ForwardButton"
                Grid.Column="1"
                Width="36"
                Height="36"
                Padding="0"
                Click="ForwardButton_Click"
                IsEnabled="False"
                ToolTipService.ToolTip="Avançar">
                <FontIcon FontSize="14" Glyph="&#xE72A;" />
            </Button>

            <Button
                Grid.Column="2"
                Width="36"
                Height="36"
                Padding="0"
                Click="ReloadButton_Click"
                ToolTipService.ToolTip="Recarregar">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>

            <Button
                Grid.Column="3"
                Width="36"
                Height="36"
                Padding="0"
                Click="HomeButton_Click"
                ToolTipService.ToolTip="Início">
                <FontIcon FontSize="14" Glyph="&#xE80F;" />
            </Button>

            <TextBox
                x:Name="AddressBox"
                Grid.Column="4"
                Margin="4,0"
                VerticalAlignment="Center"
                IsReadOnly="True" />

            <Button
                Grid.Column="5"
                Width="36"
                Height="36"
                Padding="0"
                Click="OpenInBrowserButton_Click"
                ToolTipService.ToolTip="Abrir no navegador padrão">
                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
            </Button>
        </Grid>

        <ProgressBar
            x:Name="LoadingBar"
            Grid.Row="1"
            Height="2"
            IsIndeterminate="True"
            Visibility="Collapsed" />

        <WebView2
            x:Name="WebView"
            Grid.Row="2" />
    </Grid>
</Window>
