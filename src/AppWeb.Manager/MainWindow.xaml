<Window
    x:Class="AppWeb.Manager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AppWeb.Manager.Models">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Web Apps" />
                <TextBlock
                    x:Name="AppsCountText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Carregando..." />
            </StackPanel>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="AddButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Novo Web App" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Padding="28,0,28,12">
            <TextBox
                x:Name="SearchBox"
                MaxWidth="420"
                HorizontalAlignment="Left"
                PlaceholderText="Pesquisar por nome, endereço ou descrição"
                TextChanged="SearchBox_TextChanged" />
        </Grid>

        <Grid Grid.Row="2" Padding="28,0,28,0">
            <ListView
                x:Name="AppsList"
                Padding="0,4,0,16"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:WebAppListItem">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="44"
                                    Height="44"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="8">
                                    <Grid>
                                        <FontIcon
                                            FontSize="18"
                                            Foreground="White"
                                            Glyph="&#xE774;" />
                                        <Image
                                            Source="{x:Bind Icon}"
                                            Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Url}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        MaxLines="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Details}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        Click="LaunchButton_Click"
                                        Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="Abrir">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                    </Button>
                                    <Button
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        Click="EditButton_Click"
                                        Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="Editar">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                    </Button>
                                    <Button
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        Click="DeleteButton_Click"
                                        Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="Excluir">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="40"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE774;" />
                <TextBlock
                    x:Name="EmptyStateTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Nenhum Web App ainda" />
                <TextBlock
                    x:Name="EmptyStateDescription"
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Crie um atalho no Menu Iniciar para usar qualquer site como um aplicativo."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ProgressRing
                x:Name="LoadingRing"
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="3"
            Margin="28,0,28,16"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Window>
